<Window x:Class="ConsoleTR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConsoleTR" Width="640" SizeToContent="Height" ResizeMode="CanMinimize" Language="tr-TR">
  <StackPanel Margin="20">
    <TextBlock Text="ConsoleTR" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />

    <StackPanel x:Name="SetupPanel">
      <TextBlock Text="Yakalanacak pencere" FontWeight="SemiBold" />
      <DockPanel Margin="0,4,0,10">
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Pencereleri yenile" Padding="10,2" Margin="8,0,0,0" Click="RefreshButton_Click" />
        <ComboBox x:Name="WindowCombo" />
      </DockPanel>

      <TextBlock Text="Tarama" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
        <RadioButton x:Name="AutoRadio" Content="Otomatik · Tüm pencere" IsChecked="True" Margin="0,0,16,0" Checked="ScanMode_Changed" />
        <RadioButton x:Name="ManualRadio" Content="Manuel alanlar" Checked="ScanMode_Changed" />
      </StackPanel>
      <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Margin="0,4,0,4">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Altyazı alanı (%) · Sol" VerticalAlignment="Center" />
          <TextBox x:Name="LeftBox" Text="0" Width="40" Margin="6,0,10,0" />
          <TextBlock Text="Üst" VerticalAlignment="Center" />
          <TextBox x:Name="TopBox" Text="50" Width="40" Margin="6,0,10,0" />
          <TextBlock Text="Genişlik" VerticalAlignment="Center" />
          <TextBox x:Name="WidthBox" Text="100" Width="40" Margin="6,0,10,0" />
          <TextBlock Text="Yükseklik" VerticalAlignment="Center" />
          <TextBox x:Name="HeightBox" Text="50" Width="40" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Görev bildirimi alanı" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="ObjectiveCombo" Width="120" SelectedIndex="0">
            <ComboBoxItem Content="Sağ üst" />
            <ComboBoxItem Content="Sol üst" />
          </ComboBox>
        </StackPanel>
      </StackPanel>

      <TextBlock Text="Çeviri sağlayıcısı" FontWeight="SemiBold" Margin="0,10,0,0" />
      <ComboBox x:Name="ProviderCombo" Margin="0,4,0,4" SelectedIndex="0" SelectionChanged="ProviderCombo_SelectionChanged">
        <ComboBoxItem Content="Gemma 4 · Ollama (yerel)" />
        <ComboBoxItem Content="LibreTranslate" />
        <ComboBoxItem Content="Çevrimdışı demo" />
      </ComboBox>
      <DockPanel x:Name="ModelPanel" Margin="0,2,0,2">
        <TextBlock Text="Ollama modeli" Width="150" VerticalAlignment="Center" />
        <TextBox x:Name="ModelBox" />
      </DockPanel>
      <DockPanel x:Name="AddressPanel" Margin="0,2,0,2" Visibility="Collapsed">
        <TextBlock Text="Sunucu adresi" Width="150" VerticalAlignment="Center" />
        <TextBox x:Name="AddressBox" Text="http://localhost:5000/translate" />
      </DockPanel>
      <DockPanel x:Name="NamesPanel" Margin="0,2,0,2">
        <TextBlock Text="Korunacak karakter adları" Width="150" VerticalAlignment="Center" />
        <TextBox x:Name="NamesBox" />
      </DockPanel>
      <TextBlock x:Name="ProviderNote" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,2,0,0" />
    </StackPanel>

    <TextBlock Text="Katman görünümü" FontWeight="SemiBold" Margin="0,12,0,0" />
    <DockPanel Margin="0,4,0,0">
      <TextBlock Text="Yazı boyutu" Width="150" />
      <Slider x:Name="FontSlider" Minimum="16" Maximum="56" Value="23" ValueChanged="Style_Changed" />
    </DockPanel>
    <DockPanel Margin="0,4,0,0">
      <TextBlock Text="Arka plan opaklığı" Width="150" />
      <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="0.45" ValueChanged="Style_Changed" />
    </DockPanel>

    <CheckBox x:Name="BandCheck" Content="Altyazı çevirisini altta sabit şeritte göster" IsChecked="True" Margin="0,8,0,0" Click="BandCheck_Click" />
    <DockPanel Margin="0,4,0,0">
      <TextBlock Text="Şeridin alttan uzaklığı" Width="150" />
      <Slider x:Name="BandSlider" Minimum="0" Maximum="0.4" Value="0.02" ValueChanged="Style_Changed" />
    </DockPanel>
    <CheckBox x:Name="ShowCheck" Content="Çeviriyi göster (Ctrl + Alt + T)" IsChecked="True" Margin="0,12,0,0" Click="ShowCheck_Click" />

    <DockPanel Margin="0,12,0,0">
      <Button x:Name="StartButton" Content="Başlat" Padding="18,4" IsDefault="True" Click="StartButton_Click" />
      <TextBlock x:Name="StatusText" Text="Hazır" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="DimGray" />
    </DockPanel>
    <TextBlock x:Name="MetricsText" FontSize="11" Margin="0,8,0,0" Text="Son işlem · OCR 0 ms · Çeviri 0 ms" />

    <Expander Header="Son çeviriler" IsExpanded="True" Margin="0,10,0,0">
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="RecentList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,4">
                <TextBox Text="{Binding Translation, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                <TextBox Text="{Binding Original, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="11" Foreground="Gray" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Expander>
  </StackPanel>
</Window>
